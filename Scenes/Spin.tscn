[gd_scene load_steps=3 format=2]

[ext_resource path="res://Assets/SpinAssets/Prize Wheel/Wheel Parts/Wheel 1.png" type="Texture2D" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends TextureProgressBar

var spinning_speed: float = 360.0
var random_stopping_angle: float

func _ready():
	random_stopping_angle = randf() * 360.0
	start_spinning()

func start_spinning():
	var tween = Tween.new()
	add_child(tween)
	tween.interpolate_property(self, \"radial_initial_angle\", 0, 360, 10, Tween.TRANS_LINEAR)
	tween.connect(\"tween_completed\", Callable(self, \"_on_spin_complete\"))
	tween.start()

func _on_spin_complete(object: Object, key: NodePath):
	print(\"Current angle:\", radial_initial_angle)
	print(\"Random stopping angle:\", random_stopping_angle)
	if abs(radial_initial_angle - random_stopping_angle) < 1.0:
		stop_spinning()

func stop_spinning():
	get_node(\"Tween\").stop_all()
	print(\"Spinning stopped at angle:\", radial_initial_angle)
	# Add your custom logic here (e.g., show a result, trigger an event, etc.)

func _process(delta: float):
	radial_initial_angle += deg_to_rad(spinning_speed * delta)
"

